# ~/.bashrc  (aliasi + prompt + dotnet; radi na Fedori, Debianu i Archu)

# --- Aliasi ---
# dopuni alias esesha

# --- Globalne definicije (Fedora: /etc/bashrc, Debian/Arch: /etc/bash.bashrc) ---
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
elif [ -f /etc/bash.bashrc ]; then
    . /etc/bash.bashrc
fi

# --- PATH ---
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$HOME/bin:$PATH" ;;
esac
export PATH

# ~/.bashrc.d/* (Fedora konvencija, bezopasno i drugdje)
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        [ -f "$rc" ] && . "$rc"
    done
fi
unset rc

# --- .NET ---
# DOTNET_ROOT i ~/.dotnet u PATH-u trebaju samo ako SDK instaliras rucno u ~/.dotnet
# (dotnet-install.sh). Sa paketima iz repoa nisu potrebni.
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export PATH="$PATH:$HOME/.dotnet/tools"   # globalni alati (dotnet-ef, ...)

# --- Prompt ---
PS1="\[\033[38;2;255;0;0m\]\u@\h\[\033[0m\]:\[\033[38;5;160m\]\W\[\033[0m\]\$ "
